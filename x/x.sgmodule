#!name=X去广告
#!desc=X 时间线推广推文过滤 [ 2026-11-20 ]
# 说明：
#  - 推广推文（含推广视频）都在时间线 GraphQL 响应里，带 promotedMetadata 标记，
#    脚本把它从响应里去掉，App 就不会展示也不会去加载推广视频。
#  - 依据 2026-11-20 抓包：时间线走 api.twitter.com / api.x.com 的 GraphQL；
#    8 秒内全部 43 条视频请求都是 /amplify_video/（推广视频），没有一条正常用户视频。
#  - api.twitter.com 即使在抓包 MITM 全开时也未被解密（走 CONNECT 隧道），
#    加进 MITM 列表后新连接应可解密；若时间线加载失败（证书锁定），
#    把 api.twitter.com 从 MITM 里去掉，只留 api.x.com。
[Script]
X去广告 = type=http-response,pattern=^https?:\/\/(api\.twitter\.com|api\.x\.com)\/graphql\/[A-Za-z0-9_-]+\/(HomeTimeline|HomeLatestTimeline|SearchTimeline|UserTweets|UserMedia|TweetDetail|ListTimeline|Bookmarks),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/lutqhysky/quantumultx/mylove/x/x-ads.js,script-update-interval=0
[MITM]
hostname = %APPEND% api.twitter.com, api.x.com
